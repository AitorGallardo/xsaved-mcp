# XSaved MCP server config.

# Path to the bookmark corpus the server loads at startup.
# Defaults to the bundled ./data/bookmarks.json if unset.
BOOKMARKS_PATH=./data/bookmarks.json

# --- Optional: enables the semantic_search_bookmarks tool (bridge to xsaved-rag) ---
# Point these at the SAME Postgres + OpenAI key that xsaved-rag indexed with.
# If either is missing, the server still runs — the semantic tool just isn't registered.
DATABASE_URL=postgresql://xsaved:xsaved@localhost:5432/xsaved_rag
OPENAI_API_KEY=sk-...
